# ============================================================================
# Богатырский Буст — пример конфигурации окружения
# Скопируйте в .env и заполните. Реальный .env НЕ коммитится (см. .gitignore).
# ВАЖНО (152-ФЗ): хранение и обработка ПД — только в РФ-юрисдикции
# (Yandex Cloud / российский VPS). Не указывайте здесь зарубежные хосты БД.
# ============================================================================

# --- Приложение ---
NODE_ENV=development
# Порт HTTP-сервера
PORT=3000
# Базовый префикс API
API_PREFIX=api

# --- База данных (РФ-хостинг) ---
# [TODO: уточнить у заказчика] точный адрес инстанса в Yandex Cloud / РФ-VPS
DATABASE_URL=postgresql://user:password@localhost:5432/bogatyr

# --- Очередь автопостинга (rate-limit aware) ---
# [TODO: уточнить у заказчика] Redis/иной брокер для очередей публикаций
REDIS_URL=redis://localhost:6379

# ============================================================================
# AI-шлюз (единая абстракция; провайдеры — только RU, см. spec п.4)
# Все вызовы LLM/генерации идут через KodikRouter / ITGLOBAL AIaaS
# для legal-compliant маршрутизации (152-ФЗ).
# ============================================================================
# Режим: gateway (через прослойку) | direct (напрямую к провайдеру, для dev)
AI_MODE=gateway
# [TODO: уточнить у заказчика] endpoint и ключ AI-шлюза
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=

# Текст (базовый/массовый): YandexGPT 5 Lite
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
# Текст (сложный/аналитика): GigaChat / YandexGPT 5 Pro
GIGACHAT_API_KEY=
# Изображения: Kandinsky (Сбер)
KANDINSKY_API_KEY=

# ============================================================================
# Интеграции каналов (приоритет MVP, см. spec п.3)
# ============================================================================
# 1. Telegram Bot API (основной канал MVP)
TELEGRAM_BOT_TOKEN=
# 2. Яндекс.Карты / Яндекс.Бизнес API
YANDEX_BUSINESS_API_KEY=

# --- Безопасность ---
# [TODO: уточнить у заказчика] секрет для подписи сессий/JWT
APP_SECRET=change-me-in-production
